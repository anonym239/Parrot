Window.SetBackgroundTopColor(0.03, 0.04, 0.09);
Window.SetBackgroundBottomColor(0.10, 0.05, 0.20);

logo.image = Image.Text("Parrot OS", 0.37, 0.95, 0.75, 1, "Sans Bold 52");
logo.sprite = Sprite(logo.image);
logo.x = Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2;
logo.y = Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2;
logo.sprite.SetX(logo.x);
logo.sprite.SetY(logo.y);

sub.image = Image.Text("startet ...", 0.6, 0.64, 0.78, 1, "Sans 16");
sub.sprite = Sprite(sub.image);
sub.sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - sub.image.GetWidth() / 2);
sub.sprite.SetY(logo.y + logo.image.GetHeight() + 20);

counter = 0;
fun refresh_callback() {
    counter = counter + 1;
    logo.sprite.SetOpacity(0.65 + 0.35 * Math.Sin(counter / 12));
}
Plymouth.SetRefreshFunction(refresh_callback);
